{
  "name": "spiffy-round",
  "description": "A spiffy rounder for numbers",
  "author": {
    "name": "Luke Scott",
    "email": "luke.m.scott@gmail.com",
    "url": "https://lukescott.co"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lukeaus/spiffy-round/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukeaus/spiffy-round.git"
  },
  "homepage": "https://github.com/lukeaus/spiffy-round#readme",
  "version": "0.0.0-development",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"const f=require('node:fs');for(const d of['.build','dist'])f.rmSync(d,{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && rollup -c rollup.config.mjs",
    "test": "tsx --test src/index.test.ts && node scripts/audit-project-only.mjs --self-test",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:package": "tsx --test scripts/validate-package.ts",
    "semantic-release": "semantic-release"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "unpkg": "dist/index.umd.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.mjs",
    "dist/index.umd.js",
    "dist/index.d.ts",
    "media/logo.png"
  ],
  "devDependencies": {
    "@types/node": "20.19.43",
    "prettier": "3.9.6",
    "rollup": "4.62.2",
    "semantic-release": "25.0.8",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "keywords": [
    "round",
    "rounder",
    "rounding",
    "number",
    "string",
    "decimal places"
  ]
}
